    },
    {
      "parameters": {
        "jsCode": "const stories = $input.all();\n\nreturn stories\n  .filter(item => (item.json.score || 0) >= 100)\n  .sort((a, b) => (b.json.score || 0) - (a.json.score || 0))\n  .slice(0, 5);"
      },
