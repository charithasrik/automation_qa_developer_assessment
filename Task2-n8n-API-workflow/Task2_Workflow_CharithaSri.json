    {
      "parameters": {
        "jsCode": "const stories = $input.all();\n\nconst digest = stories.map((item, index) => {\n  const story = item.json;\n\n  return `${index + 1}. ${story.title}\nScore: ${story.score || 0}\nAuthor: ${story.by || \"Unknown\"}\nComments: ${story.descendants || 0}\n${story.url || `https://news.ycombinator.com/item?id=${story.id}`}`;\n}).join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      notification: \"Hacker News Hourly Digest\",\n      story_count: stories.length,\n      digest: digest\n    }\n  }\n];"
      },
